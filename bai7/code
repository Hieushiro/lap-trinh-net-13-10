namespace bai7_13_10
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
            dgvData.Columns.Add("Id", "Mã");
            dgvData.Columns.Add("Name", "Tên sản phẩm/Sinh viên");
            dgvData.Rows.Add("01", "Dữ liệu mẫu A");
            dgvData.Rows.Add("02", "Dữ liệu mẫu B");
        }

        private void Form1_Load(object sender, EventArgs e)
        {

        }
        private void SendMessageToParent(string actionName)
        {
            // Ép kiểu ngược lại thành FormMain để gọi hàm Public công khai
            FormChild mainForm = this.MdiParent as FormChild;
            if (mainForm != null)
            {
                mainForm.UpdateStatusMessage(actionName);
            }
        }

        // Sự kiện click nút bấm trên Form con
        private void btnTrigger_Click(object sender, EventArgs e)
        {
            SendMessageToParent("Thao tác thành công từ nút bấm!");
        }

        // --- Các sự kiện từ Menu chuột phải ContextMenuStrip ---
        private void ctxDelete_Click(object sender, EventArgs e)
        {
            if (dgvData.CurrentRow != null && !dgvData.CurrentRow.IsNewRow)
            {
                dgvData.Rows.Remove(dgvData.CurrentRow);
                SendMessageToParent("Đã xóa thành công 1 dòng trên lưới dữ liệu.");
            }
        }

        private void ctxRefresh_Click(object sender, EventArgs e)
        {
            SendMessageToParent("Đã làm mới dữ liệu lưới thành công.");
        }

        private void ctxDetail_Click(object sender, EventArgs e)
        {
            if (dgvData.CurrentRow != null)
            {
                string info = dgvData.CurrentRow.Cells[1].Value?.ToString();
                MessageBox.Show($"Thông tin chi tiết: {info}", "Xem chi tiết");
                SendMessageToParent("Đã xem chi tiết phần tử.");
            }
        }
    }
}
